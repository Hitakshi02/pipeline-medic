# Copy to .env and add your key. Never commit the populated file.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL=muse-spark-1.3
# minimal | low | medium | high | max
REASONING_EFFORT=low
# on: verification layer (checks inside the tools, escalation, engineer sign-off); off: baseline
VERIFICATION=on
# The incident to work on, relative to this folder
INCIDENT_DIR=../incidents/INC-001
